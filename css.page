.main-page-header {
    background-color: pink;  /* this takes the class from the html file and changes the background colour */
    color: white;          /* this is used for the text */
    font-size: 15px; 
    text-align: center;  /*i mae the about me at the center of the page*/
    padding: 13px;       /* this is the space INSIDE the margin.  */
}
body {
    font-family: Arial, sans-serif; /* means everything inside body wil be in this font*/
    background-color: #fff0f5;
}
.cv-section {
    background-color: white;         /* this is the colour inside this section*/
    padding: 15px;                  /* padding is the space inside and how big u want it*/
    margin: 20px;                  /*this means the space between each section*/
    border-radius: 15px;          /* this rounds the corners to give it a softer look*/
    
}
     
  .navigation {
    list-style-type: none;
    /* Removes bullet points from a list.
       This is usually applied to a <ul> or <ol>, not a <nav>. */

    padding: 0;
    /* Removes the default spacing that browsers add to lists. */
}

.navigation {
    text-align: center; /* this makes the button at the centre of the webpage*/
}

.navigation a {
    /* Styles every <a> tag inside the navigation class */

    background-color: #c2185b;
    /* Changes the button background colour */

    color: white;
    /* Changes the text colour */

    text-decoration: none;
    /* Removes the default underline from links */

    padding: 10px 15px;
    /* Adds space inside the button
       10px = top and bottom
       15px = left and right */

    border-radius: 8px;
    /* Rounds the corners of the button */

    margin: 5px;
    /* Adds space outside the button */

    display: inline-block;
    /* Allows the link to behave like a button
       while staying on the same line as other links */
}   
.navigation a:hover { /* this changes the colour of the button when u hover over it*/
    background-color: #8e1747;
}
img {
    width: 250px;  /*controls how wide the image can be*/
    height: auto; /* height changes according to image size so it doesnt squash it*/
    border-radius: 15px; /* makes the picture round on the edges*/
    display: block; /* the image would want to sit next to the text without display block*/
    margin: 0 auto; /*centers the image*/
}
@media (min-width: 481px) and (max-width: 768px) { /*media means use this in certain situations. so the screen must be 481 pixels wide. and must not be wider than 768px */

    body {      /* adds this to the entire webpage so everything inside body */
        font-size: 14px;    /* so text size may be smaller beacuse te screen is smaller */
    }

    .cv-section {
        margin: 10px;          /* margin and padding are different sizes because in a tablet there is less room */
        padding: 10px;
    }

    .navigation a {
        padding: 8px 12px;   /* top and bottom spacing 8px*/
                            /* left and right spacing*?
    }

    img {
        width: 120px;      /* targrets every image and makes it smaller */
    }
}
@media (max-width: 480px) {

    body {
        font-size: 12px;
    }

    .navigation {
        display: flex;      /*turns the naviagtion bar into a flexbox container so sits side by side */
        flex-direction: column;   /* column because columns go down  so if i put flex direction: row it would be horiztonal.*/
    }

    .navigation a {
        margin: 5px;    /* targets every link inside the naviagtion */
    }

    .cv-section {
        border-top: 2px solid #c2185b;   /* adds a pink line above each section since eberything stacks vertically it helps to separate*/
        margin-top: 15px;
        padding-top: 15px;
    }

    h1 {
        font-size: 24px;  /* different headings are diff sizes so it can fit in smaller screens.*/
    }

    h2 {
        font-size: 18px;
    }

    img {
        width: 100px;      /* makes all images smaller*/
        height: auto;      /* keeps the image proprtions correct*/
    }
}
